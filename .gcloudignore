# .gcloudignore - Exclude files from Cloud Build uploads

# Dependencies (installed during build)
node_modules/

# Build artifacts (rebuilt in Cloud Build)
.next/

# Git history
.git/

# Local environment files (secrets managed via Secret Manager)
.env
.env.local
.env.production
.env.development

# TypeScript build info
tsconfig.tsbuildinfo

# Logs
npm-debug.log*
*.log

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Documentation (not needed for build)
*.md

# Local docker files
bash.exe.stackdump
